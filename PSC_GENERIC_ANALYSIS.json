    {
      "id": "native_modules",
      "behavior": "PSII/PSIII game logic is split into native Thumb modules rather than a conventional per-instruction 68000 interpreter.",
      "md2gba_use": "translate discovered guest code into native regions and reserve generic dispatch for indirect/dynamic edges."
    },
    {
      "id": "native_continuation_table",
      "behavior": "most recognized module shells reduce a signed selector modulo 1024, subtract a module-local base, range-check it, then jump through a dense native continuation table.",
      "md2gba_use": "compile each guest region to dense local continuation IDs; resolve direct edges natively and use a compact dispatcher only at region/dynamic boundaries."
    },
    {
      "id": "explicit_continuation_state",
      "behavior": "translated cases write continuation/callback pointers into GBA RAM state and resume through native module selectors.",
      "md2gba_use": "make continuation state an explicit compiler IR concept instead of materializing guest PC after every instruction."
    },
    {
      "id": "same_module_native_redispatch",
      "behavior": "observed PSIII module epilogues mask the returned continuation token by its 1024-selector module prefix and, when it still belongs to the current module, call the local dense native selector dispatcher again rather than entering a 68000 interpreter.",
      "md2gba_use": "when a hot superblock cannot continue as one block, resume through a generated exact native continuation in the same region; do not decode/interpret one guest instruction as the normal seam."
    },
    {
      "id": "cross_module_native_return",
      "behavior": "when a continuation token names another module, PSC writes cached native state registers back to shared GBA RAM and returns the token to the outer dispatcher.",
      "md2gba_use": "treat region/module crossings as explicit compiler continuation exits with a compact state sync, while keeping direct intra-region edges native."
    },
    {
      "id": "invalid_selector_native_default",
      "behavior": "unpopulated selector slots observed in native modules route to a generated default epilogue that synchronizes state and returns a neutral token rather than interpreting arbitrary guest bytes.",
      "md2gba_use": "generate explicit cold/default continuation cases for unresolved region-local selectors; reserve the generic 68k interpreter only for code the offline compiler truly did not translate."
    },
    {
      "id": "shared_bus",
      "behavior": "PSII and PSIII contain strongly similar Genesis-address bus helpers rather than title-specific GBA address access.",
      "md2gba_use": "keep one generic 24-bit Genesis bus, but inline/direct ordinary ROM/WRAM paths."
